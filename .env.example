# Copy this file to .env and fill in the values. .env is gitignored.

# Helius API key. Solana RPC, used for phase 2 enrichment only.
# Get it at https://dashboard.helius.dev -> create a project -> copy the API key.
# Free tier: 1M credits/month, 10 requests/sec.
# NOT needed for phase 1 ingest: that runs off PumpPortal, which is free and
# unauthenticated. Helius WebSocket ingest was abandoned after the dashboard
# showed 35,989 credits burned in under an hour. See DEVLOG.md.
HELIUS_API_KEY=

# Birdeye API key. Holder distribution, OHLCV, historical data (phase 2 onward).
# Get it at https://bds.birdeye.so -> sign up -> Security/API key.
BIRDEYE_API_KEY=

# Telegram bot token. Used to send alerts (phase 4 onward).
# Message @BotFather on Telegram -> /newbot -> copy the token it gives you.
TELEGRAM_BOT_TOKEN=

# Telegram chat ID. The chat the bot sends alerts to (phase 4 onward).
# Message your bot once, then open
# https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/getUpdates and read result[0].message.chat.id
TELEGRAM_CHAT_ID=


# ---------------------------------------------------------------------------
# Optional tuning. All of these have working defaults; leave them commented out
# unless you have a reason to change one.
# ---------------------------------------------------------------------------

# PumpPortal creation feed. Free, no key, no auth.
#PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# Which programs the Helius resolver knows about. Phase 2 only; phase 1 ingest
# no longer uses these.
# Options: pumpfun, pumpswap, raydium_amm_v4, raydium_cpmm, raydium_launchlab
#WATCH_PROGRAMS=pumpfun,raydium_amm_v4,raydium_cpmm

# SQLite database file.
#DB_PATH=scanner.db

# Spend 1 Helius credit per Raydium pool creation to look up the token mint.
# pump.fun launches never need this: the mint is already in the log data.
#RESOLVE_RAYDIUM_MINTS=true

# Client-side cap on Helius RPC calls per second. Free tier limit is 10.
#RPC_MAX_REQUESTS_PER_SEC=5

# Seconds of total WebSocket silence before we assume the connection is dead
# and reconnect. A silently dead socket at 3am is the main failure mode.
# 600s suits the PumpPortal creation feed (~30 launches/min, and far fewer
# overnight). It was 90s when ingest watched a 1,100 msg/sec firehose.
#WS_SILENCE_TIMEOUT_SECONDS=600

# How often to print the running status line.
#STATUS_INTERVAL_SECONDS=30

# Estimated Helius credits per Helius WebSocket notification. Measured at
# ~0.01 from the dashboard. Ingest no longer holds a Helius socket, so this
# should never fire; it is kept so the meter stays honest if one is reopened.
#WS_MESSAGE_CREDIT_COST=0.01
